{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NutriFacts food evidence record",
  "type": "object",
  "required": ["schema_version", "food", "findings"],
  "properties": {
    "schema_version": { "type": "string" },
    "food": {
      "type": "object",
      "required": ["id", "name", "scientific_name", "preparation", "food_part", "image", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "scientific_name": { "type": ["string", "null"] },
        "preparation": { "type": ["string", "null"] },
        "food_part": { "type": "string", "minLength": 1 },
        "image": { "$ref": "#/$defs/foodImage" },
        "source": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "carbohydrate_map": { "$ref": "#/$defs/carbohydrateMap" },
    "part_context": { "$ref": "#/$defs/partContext" }
  },
  "$defs": {
    "foodImage": {
      "type": "object",
      "required": ["path", "source_url", "source_file_url", "creator", "license", "license_url", "alt", "depicts", "taxon_name", "food_match", "identity_scope", "modification"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "source_file_url": { "type": "string", "format": "uri" },
        "creator": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "format": "uri" },
        "alt": { "type": "string", "minLength": 1 },
        "depicts": { "type": "string", "minLength": 1 },
        "taxon_name": { "type": "string", "minLength": 1 },
        "food_match": { "type": "string", "minLength": 1 },
        "identity_scope": { "type": "string", "minLength": 1 },
        "modification": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "carbohydrateMap": {
      "type": "object",
      "required": ["note", "sources", "records"],
      "properties": {
        "note": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextSource" }
        },
        "records": {
          "type": "array",
          "items": { "$ref": "#/$defs/carbohydrateRecord" }
        }
      },
      "additionalProperties": false
    },
    "partContext": {
      "type": "object",
      "required": ["note", "parts"],
      "properties": {
        "note": { "type": "string", "minLength": 1 },
        "parts": { "type": "array", "items": { "$ref": "#/$defs/partContextRecord" } }
      },
      "additionalProperties": false
    },
    "partContextRecord": {
      "type": "object",
      "required": ["id", "label", "anatomical_terms", "summary", "sample_context", "sources"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "anatomical_terms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "summary": { "type": "string", "minLength": 1 },
        "sample_context": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/partSource" } }
      },
      "additionalProperties": false
    },
    "partSource": {
      "type": "object",
      "required": ["name", "url", "citation", "license"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "citation": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "contextSource": {
      "type": "object",
      "required": ["id", "name", "url", "citation", "license"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "citation": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "carbohydrateRecord": {
      "type": "object",
      "required": ["id", "name", "group", "class", "part", "evidence_status", "reliability_category", "amount", "relationship", "building_blocks", "sample_context", "source_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "group": { "enum": ["Soluble sugars", "Cell-wall polysaccharides"] },
        "class": { "type": "string", "minLength": 1 },
        "part": { "type": "string", "minLength": 1 },
        "evidence_status": { "enum": ["detected", "predicted", "unknown"] },
        "reliability_category": { "enum": ["direct_measurement", "limited_context", "predicted", "unreviewed", "unknown"] },
        "amount": { "type": ["number", "null"], "minimum": 0 },
        "relationship": { "type": "string", "minLength": 1 },
        "building_blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "sample_context": { "type": "string", "minLength": 1 },
        "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["name", "url", "license"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "food_data_central_id": { "type": "integer" },
        "license": { "type": "string", "minLength": 1 },
        "citation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "id", "name", "kind", "category", "unit_label", "formula", "pubchem_cid",
        "pubchem_3d_conformer_available", "evidence_status", "measurement_status",
        "curation_status", "reliability_category", "measurement", "method", "sources", "note"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["compound", "protein", "protein_group", "carbohydrate", "food_fraction", "other"] },
        "category": { "type": "string", "minLength": 1 },
        "unit_label": { "type": "string", "minLength": 1 },
        "formula": { "type": ["string", "null"] },
        "pubchem_cid": { "type": ["integer", "null"] },
        "pubchem_3d_conformer_available": { "type": "boolean" },
        "evidence_status": { "enum": ["detected", "predicted", "unknown"] },
        "measurement_status": { "enum": ["measured", "derived", "not_quantified"] },
        "curation_status": { "type": "string" },
        "reliability_category": { "enum": ["direct_measurement", "limited_context", "predicted", "unreviewed", "unknown"] },
        "measurement": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["reported", "display_per_gram", "sample_count", "conversion"],
              "properties": {
                "reported": { "$ref": "#/$defs/quantity" },
                "display_per_gram": { "$ref": "#/$defs/quantity" },
                "sample_count": { "type": ["integer", "null"], "minimum": 1 },
                "conversion": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        },
        "method": {
          "type": "object",
          "required": ["name", "details", "reference_doi"],
          "properties": {
            "name": { "type": "string" },
            "details": { "type": "string" },
            "reference_doi": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "quantity": {
      "type": "object",
      "required": ["value", "unit", "range"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1 },
        "range": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
